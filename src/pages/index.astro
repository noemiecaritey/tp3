---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <h1 class="text-2xl">Test Astro et Plot (Observablehq)</h1>
  <PlotFigure
    options={{
      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
        }),
      ],
    }}
  />
  <nav class="flex justify-center gap-6 p-6">
  <a
    href="/specie"
    class="rounded px-4 py-2 font-bold hover:bg-red-200"
  >
    Les espèces de pingouins
  </a>
</nav>
</Layout>
