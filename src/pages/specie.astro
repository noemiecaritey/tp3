---
import { Tabs, TabsList, TabsTab, TabsPanel } from 'accessible-astro-components';
import GraphicSpecies from "../components/GraphicSpecies.astro";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Les espèces de pingouins</title>
  </head>

  <body>
    <main class="p-8">
      <h1 class="text-2xl font-bold mb-6">Les espèces de pingouins</h1>

      <Tabs>
        <TabsList class="flex gap-2 mb-4">
          <TabsTab
            id="tab-adelie"
            controls="panel-adelie"
            selected
            class="px-4! py-2! rounded-t! font-bold! border-2! border-b-0! aria-selected:bg-red-200! aria-selected:border-red-400!"
          >
            Adelie
          </TabsTab>
          <TabsTab
            id="tab-gentoo"
            controls="panel-gentoo"
            class="px-4! py-2! rounded-t! font-bold! border-2! border-b-0! aria-selected:bg-red-200! aria-selected:border-red-400!"
          >
            Gentoo
          </TabsTab>
          <TabsTab
            id="tab-chinstrap"
            controls="panel-chinstrap"
            class="px-4! py-2! rounded-t! font-bold! border-2! border-b-0! aria-selected:bg-red-200! aria-selected:border-red-400!"
          >
            Chinstrap
          </TabsTab>
        </TabsList>

        <TabsPanel id="panel-adelie" labelledby="tab-adelie" selected class="p-4! border-2!">
          <h2 class="text-center font-semibold mb-4">Adelie</h2>
          <GraphicSpecies penguins={penguins} species="Adelie" />
        </TabsPanel>

        <TabsPanel id="panel-gentoo" labelledby="tab-gentoo" class="p-4! border-2!">
          <h2 class="text-center font-semibold mb-4">Gentoo</h2>
          <GraphicSpecies penguins={penguins} species="Gentoo" />
        </TabsPanel>

        <TabsPanel id="panel-chinstrap" labelledby="tab-chinstrap" class="p-4! border-2!">
          <h2 class="text-center font-semibold mb-4">Chinstrap</h2>
          <GraphicSpecies penguins={penguins} species="Chinstrap" />
        </TabsPanel>
      </Tabs>
    </main>
  </body>
</html>