---
import GraphicSpecies from "../components/GraphicSpecies.astro";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Les espèces de pingouins</title>

    <style>
      body {
        margin: 0;
        font-family: sans-serif;
      }

      main {
        padding: 30px;
      }

      /* Menu */
      nav {
        display: flex;
        justify-content: center;
        gap: 30px;
        padding: 20px;
        position: sticky;
        top: 0;
        background-color: white;
        z-index: 10;
      }

      nav a {
        color: black;
        text-decoration: none;
        font-weight: bold;
      }

      /* Slider horizontal */
      .slider {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
      }

      /* Chaque graphique prend toute la largeur */
      .graphique {
        min-width: 100%;
        scroll-snap-align: start;
        padding: 30px 0;
      }

      .graphique h2 {
        text-align: center;
      }
      .menu-item {
        color: black;
        text-decoration: none;
        font-weight: bold;
      }

     .menu-item.active {
        text-decoration: underline;
        font-weight: bold;
    }
    </style>
  </head>

  <body>
    <main>
      <h1>Les espèces de pingouins</h1>

      <!-- Menu -->
       <nav>
        <select id="species">
          <option value="adelie">Adelie</option>
          <option value="gentoo">Gentoo</option>
          <option value="chinstrap">Chinstrap</option>
        </select>
      </nav>

      <!-- Slider -->
      <div class="slider">

        <section id="adelie" class="graphique">
          <h2>Adelie</h2>

          <GraphicSpecies
            penguins={penguins}
            species="Adelie"
          />
        </section>

        <section id="gentoo" class="graphique">
          <h2>Gentoo</h2>

          <GraphicSpecies
            penguins={penguins}
            species="Gentoo"
          />
        </section>

        <section id="chinstrap" class="graphique">
          <h2>Chinstrap</h2>

          <GraphicSpecies
            penguins={penguins}
            species="Chinstrap"
          />
        </section>

      </div>
    </main>
  </body>
</html>

<script>
  const items = document.querySelectorAll(".graphique");
  const select = document.querySelector("#species");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          if (select) (select as HTMLSelectElement).value = id ?? "";
        }
      });
    },
    { threshold: 0.5 }
  );

  items.forEach((item) => observer.observe(item));

  select?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.hash = value;
  });
</script>